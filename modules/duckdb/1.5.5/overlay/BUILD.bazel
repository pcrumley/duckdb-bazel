"""Bazel build for DuckDB.

Mirrors upstream's CMake build: the core library in src/, the vendored libraries in
third_party/ that it always links, and the in-tree extensions selected by flags.

Optimisation level, NDEBUG and the C++ standard are left to the consumer's toolchain and
compilation mode (upstream's release build is the equivalent of `-c opt`).
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

licenses(["notice"])  # MIT

exports_files(["LICENSE"])

# Use DuckDB's vendored jemalloc for its own allocations, as upstream does by default on
# 64-bit glibc Linux. It is prefixed (duckdb_je_*) and does not replace malloc for the
# rest of the process. Only has an effect on Linux. Turn it off for musl, where upstream
# does not support it:
#   --@duckdb//:jemalloc=false
bool_flag(
    name = "jemalloc",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "jemalloc_enabled",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {":jemalloc": "true"},
)

# In-tree extensions that can be linked into the library, and whether they are by default
# (the defaults match upstream's). core_functions is always linked. Set with, for example:
#   --@duckdb//:json=true
#   --@duckdb//:parquet=false
OPTIONAL_EXTENSIONS = {
    "autocomplete": False,
    "json": False,
    "parquet": True,
    "tpch": False,
}

[
    bool_flag(
        name = ext,
        build_setting_default = default,
        visibility = ["//visibility:public"],
    )
    for ext, default in OPTIONAL_EXTENSIONS.items()
]

[
    config_setting(
        name = ext + "_enabled",
        flag_values = {":" + ext: "true"},
        visibility = ["//visibility:public"],
    )
    for ext in OPTIONAL_EXTENSIONS
]

DUCKDB_VERSION = "v1.5.5"

# Short commit id of the release tag, as reported by `PRAGMA version`.
DUCKDB_SOURCE_ID = "d8cdaa33fd"

COMMON_DEFINES = ["DUCKDB_BUILD_LIBRARY"]

# Upstream compiles most vendored code with warnings off. It also uses
# -fvisibility=hidden for some of it, which is left out here: Bazel links each cc_library
# as its own shared object in dynamic mode, and the core library needs those symbols.
THIRD_PARTY_COPTS = ["-w"]

# Include directories upstream puts on the command line of every translation unit.
THIRD_PARTY_INCLUDES = [
    "third_party/concurrentqueue",
    "third_party/fast_float",
    "third_party/fastpforlib",
    "third_party/fmt/include",
    "third_party/fsst",
    "third_party/httplib",
    "third_party/hyperloglog",
    "third_party/jaro_winkler",
    "third_party/mbedtls/include",
    "third_party/miniz",
    "third_party/pcg",
    "third_party/pdqsort",
    "third_party/re2",
    "third_party/ska_sort",
    "third_party/skiplist",
    "third_party/tdigest",
    "third_party/utf8proc/include",
    "third_party/vergesort",
    "third_party/yyjson/include",
    "third_party/zstd/include",
]

# The public API: only src/include is visible to consumers.
cc_library(
    name = "headers",
    hdrs = glob([
        "src/include/**/*.h",
        "src/include/**/*.hpp",
    ]),
    includes = ["src/include"],
)

# Headers of every vendored library, with upstream's include paths. Internal: the public
# target depends on it through implementation_deps so the paths do not reach consumers.
cc_library(
    name = "third_party_headers",
    hdrs = glob(
        [
            "third_party/**/*.h",
            "third_party/**/*.hpp",
        ],
        exclude = [
            "third_party/catch/**",
            "third_party/jemalloc/**",
        ],
    ),
    includes = THIRD_PARTY_INCLUDES,
    # Sources that are #included by other sources rather than compiled on their own.
    textual_hdrs = [
        "third_party/libpg_query/grammar/grammar.cpp",
        "third_party/utf8proc/utf8proc_data.cpp",
    ],
    deps = [":headers"],
)

cc_library(
    name = "jemalloc_lib",
    srcs = glob(["third_party/jemalloc/src/*.c"]),
    hdrs = glob(["third_party/jemalloc/include/**/*.h"]),
    copts = THIRD_PARTY_COPTS + ["-std=gnu99"],
    includes = ["third_party/jemalloc/include"],
    local_defines = COMMON_DEFINES,
    deps = [":headers"],
)

cc_library(
    name = "pg_query_headers",
    includes = [
        "third_party/libpg_query",
        "third_party/libpg_query/include",
    ],
    deps = [":third_party_headers"],
)

cc_library(
    name = "fastpforlib",
    srcs = glob(["third_party/fastpforlib/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "fmt",
    srcs = glob(["third_party/fmt/**/*.cc"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "fsst",
    srcs = glob(["third_party/fsst/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "hyperloglog",
    srcs = glob(["third_party/hyperloglog/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "pg_query",
    srcs = glob(
        ["third_party/libpg_query/**/*.cpp"],
        exclude = ["third_party/libpg_query/grammar/grammar.cpp"],
    ),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":pg_query_headers"],
)

cc_library(
    name = "mbedtls",
    srcs = glob(["third_party/mbedtls/**/*.cpp"]),
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "miniz",
    srcs = glob(["third_party/miniz/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "re2",
    srcs = glob(["third_party/re2/**/*.cc"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES + ["RE2_ON_VALGRIND"],
    deps = [":third_party_headers"],
)

cc_library(
    name = "skiplist",
    srcs = glob(["third_party/skiplist/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "utf8proc",
    srcs = glob(
        ["third_party/utf8proc/**/*.cpp"],
        exclude = ["third_party/utf8proc/utf8proc_data.cpp"],
    ),
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "yyjson",
    srcs = glob(["third_party/yyjson/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

cc_library(
    name = "zstd",
    srcs = glob(["third_party/zstd/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":third_party_headers"],
)

# Vendored libraries used only by the parquet extension.
cc_library(
    name = "parquet_third_party_headers",
    includes = [
        "third_party/brotli/include",
        "third_party/lz4",
        "third_party/parquet",
        "third_party/snappy",
        "third_party/thrift",
    ],
    # Template implementations that thrift's headers #include.
    textual_hdrs = glob(["third_party/thrift/**/*.tcc"]),
    deps = [":third_party_headers"],
)

cc_library(
    name = "brotli",
    srcs = glob(["third_party/brotli/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":parquet_third_party_headers"],
)

cc_library(
    name = "lz4",
    srcs = glob(["third_party/lz4/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":parquet_third_party_headers"],
)

cc_library(
    name = "parquet_format",
    srcs = glob(["third_party/parquet/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":parquet_third_party_headers"],
)

cc_library(
    name = "snappy",
    srcs = glob(
        ["third_party/snappy/**/*.cc"],
        exclude = ["third_party/snappy/snappy-stubs-internal.cc"],
    ),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":parquet_third_party_headers"],
)

cc_library(
    name = "thrift",
    srcs = glob(["third_party/thrift/**/*.cpp"]),
    copts = THIRD_PARTY_COPTS,
    local_defines = COMMON_DEFINES,
    deps = [":parquet_third_party_headers"],
)

# Extensions. To add one: add its library below as <name>_extension, add it to
# OPTIONAL_EXTENSIONS, and add it to the two files in generated/.
cc_library(
    name = "core_functions_extension",
    srcs = glob(["extension/core_functions/**/*.cpp"]),
    hdrs = glob(["extension/core_functions/include/**/*.hpp"]),
    includes = ["extension/core_functions/include"],
    local_defines = COMMON_DEFINES + [
        'EXT_VERSION_CORE_FUNCTIONS=\\"%s\\"' % DUCKDB_VERSION,
    ],
    deps = [":third_party_headers"],
)

cc_library(
    name = "autocomplete_extension",
    srcs = glob(["extension/autocomplete/**/*.cpp"]),
    hdrs = glob(["extension/autocomplete/include/**/*.hpp"]),
    includes = ["extension/autocomplete/include"],
    local_defines = COMMON_DEFINES + [
        'EXT_VERSION_AUTOCOMPLETE=\\"%s\\"' % DUCKDB_VERSION,
    ],
    deps = [":third_party_headers"],
)

cc_library(
    name = "json_extension",
    srcs = glob(["extension/json/**/*.cpp"]),
    hdrs = glob(["extension/json/include/**/*.hpp"]),
    includes = ["extension/json/include"],
    local_defines = COMMON_DEFINES + [
        'EXT_VERSION_JSON=\\"%s\\"' % DUCKDB_VERSION,
    ],
    deps = [
        ":third_party_headers",
        ":yyjson",
    ],
)

cc_library(
    name = "parquet_extension",
    srcs = glob(["extension/parquet/**/*.cpp"]),
    hdrs = glob(["extension/parquet/include/**/*.hpp"]),
    includes = ["extension/parquet/include"],
    local_defines = COMMON_DEFINES + [
        'EXT_VERSION_PARQUET=\\"%s\\"' % DUCKDB_VERSION,
    ],
    deps = [
        ":brotli",
        ":lz4",
        ":miniz",
        ":parquet_format",
        ":parquet_third_party_headers",
        ":snappy",
        ":thrift",
        ":zstd",
    ],
)

cc_library(
    name = "tpch_extension",
    srcs = glob(["extension/tpch/**/*.cpp"]),
    hdrs = glob([
        "extension/tpch/include/**/*.hpp",
        "extension/tpch/dbgen/include/**/*.h",
        "extension/tpch/dbgen/include/**/*.hpp",
    ]),
    # dbgen is the TPC's data generator, adapted by upstream; its warnings are off
    # there too.
    copts = THIRD_PARTY_COPTS,
    includes = [
        "extension/tpch/dbgen/include",
        "extension/tpch/include",
    ],
    local_defines = COMMON_DEFINES + [
        'EXT_VERSION_TPCH=\\"%s\\"' % DUCKDB_VERSION,
    ],
    deps = [":third_party_headers"],
)

# For each optional extension: its library and the define that tells the loader about
# it, or nothing when its flag is off.
[
    cc_library(
        name = ext + "_if_enabled",
        defines = select({
            ":%s_enabled" % ext: ["DUCKDB_EXTENSION_%s_LINKED=1" % ext.upper()],
            "//conditions:default": [],
        }),
        deps = select({
            ":%s_enabled" % ext: [":%s_extension" % ext],
            "//conditions:default": [],
        }),
    )
    for ext in OPTIONAL_EXTENSIONS
]

# Registers the linked extensions with the core library. Upstream's CMake generates the
# two files in generated/ at configure time; here they are fixed files that switch on
# the DUCKDB_EXTENSION_<NAME>_LINKED defines.
cc_library(
    name = "extension_loader",
    srcs = ["generated/generated_extension_loader.cpp"],
    hdrs = ["generated/generated_extension_headers.hpp"],
    includes = ["generated"],
    # Private, so that the extensions' include paths and defines stay off the core
    # library's command lines and changing the set of extensions does not recompile it.
    implementation_deps = [":core_functions_extension"] + [
        ":%s_if_enabled" % ext
        for ext in OPTIONAL_EXTENSIONS
    ],
    local_defines = COMMON_DEFINES + [
        "GENERATED_EXTENSION_HEADERS=1",
        "DUCKDB_EXTENSION_CORE_FUNCTIONS_LINKED=1",
    ],
    deps = [":third_party_headers"],
)

# The only core sources that depend on whether jemalloc is enabled. They are a separate
# target so that flipping the flag recompiles these and not the whole core library.
ALLOCATOR_SRCS = [
    "src/common/allocator/allocator_jemalloc.cpp",
    "src/common/allocator/allocator_standard.cpp",
    "src/parallel/task_scheduler.cpp",
]

CORE_DEFINES = COMMON_DEFINES + [
    "DUCKDB",
    "DUCKDB_MAIN_LIBRARY",
]

cc_library(
    name = "allocator",
    srcs = ALLOCATOR_SRCS,
    # allocator_jemalloc.cpp uses StringUtil without including its header. Upstream never
    # notices because its unity build compiles the file together with allocator.cpp.
    copts = select({
        ":jemalloc_enabled": [
            "-include",
            "duckdb/common/string_util.hpp",
        ],
        "//conditions:default": [],
    }),
    # Private, to keep jemalloc's include path off the core library's command lines.
    implementation_deps = select({
        ":jemalloc_enabled": [":jemalloc_lib"],
        "//conditions:default": [],
    }),
    local_defines = CORE_DEFINES + select({
        ":jemalloc_enabled": ["DUCKDB_ENABLE_JEMALLOC"],
        "//conditions:default": [],
    }),
    deps = [":third_party_headers"],
)

cc_library(
    name = "duckdb",
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = ALLOCATOR_SRCS,
    ),
    implementation_deps = [
        ":allocator",
        ":extension_loader",
        ":fastpforlib",
        ":fmt",
        ":fsst",
        ":hyperloglog",
        ":mbedtls",
        ":miniz",
        ":pg_query",
        ":pg_query_headers",
        ":re2",
        ":skiplist",
        ":third_party_headers",
        ":utf8proc",
        ":yyjson",
        ":zstd",
    ],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "-lpthread",
            "-ldl",
            "-lm",
        ],
    }),
    local_defines = CORE_DEFINES + [
        'DUCKDB_VERSION=\\"%s\\"' % DUCKDB_VERSION,
        'DUCKDB_SOURCE_ID=\\"%s\\"' % DUCKDB_SOURCE_ID,
    ],
    visibility = ["//visibility:public"],
    # The extensions and several vendored libraries call back into the core library
    # (upstream links them all into one archive). Always linking the core keeps a static
    # link correct with linkers that resolve archives in command-line order. Nearly all of
    # the core is reachable from opening a database anyway: this adds under 1% to a
    # statically linked binary.
    alwayslink = True,
    deps = [":headers"],
)
