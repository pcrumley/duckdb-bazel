# Applies the :linux, :macos or :windows lines below. It comes first because the local
# registry, set per platform, must precede the BCR.
common --enable_platform_specific_config

# Resolve duckdb from this repository, everything else from the BCR. %workspace% starts
# with a drive letter on Windows, which needs a third slash to be a valid file URL.
common:linux --registry=file://%workspace%/../..
common:macos --registry=file://%workspace%/../..
common:windows --registry=file:///%workspace%/../..
common --registry=https://bcr.bazel.build

# The lockfile would record the local registry's overlay hashes, which change on every
# edit to the overlay.
common --lockfile_mode=off

build:linux --cxxopt=-std=c++17 --host_cxxopt=-std=c++17
build:macos --cxxopt=-std=c++17 --host_cxxopt=-std=c++17
build:windows --cxxopt=/std:c++17 --host_cxxopt=/std:c++17
# DuckDB takes UTF-8 strings, and MSVC encodes string literals in the system code page
# unless told otherwise. Upstream's CMake build passes this for everything it compiles.
build:windows --cxxopt=/utf-8 --host_cxxopt=/utf-8
test --test_output=errors

# Keeps compiled objects across overlay edits and `bazel clean`: a clean DuckDB build is
# over ten minutes, and switching a flag back would otherwise recompile it.
build --disk_cache=~/.cache/duckdb-bazel-disk-cache

# Link every optional extension so the smoke test covers them all.
build --@duckdb//:autocomplete=true
build --@duckdb//:icu=true
build --@duckdb//:json=true
build --@duckdb//:tpcds=true
build --@duckdb//:tpch=true
